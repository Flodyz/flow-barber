# ============================================
# CONFIGURAÇÕES DO SERVIDOR
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=seu_jwt_secret_super_seguro_aqui_change_in_production_123456

# ============================================
# DATABASE - PostgreSQL
# ============================================
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Desenvolvimento Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbearia?schema=public"

# Docker (quando usar docker-compose):
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/barbearia?schema=public"

# Produção (exemplo):
# DATABASE_URL="postgresql://user:password@host:5432/barbearia?schema=public"
